{
   "id":"bajrang_baan",
   "title":"बजरंग बाण",
   "language":"hi",
   "script":"Devanagari",
   "author":"Traditional",
   "publicDomain":true,
   "audio":"bajrang_baan.mp3",
   "verses":[
      {
         "id":1,
         "type":"doha",
         "text":"॥ दोहा ॥\nनिश्चय प्रेम प्रतीति ते, विनय करैं सनमान।\nतेहि के कारज सकल शुभ, सिद्ध करैं हनुमान॥"
      },
      {
         "id":2,
         "type":"chaupai",
         "text":"जय हनुमंत संत हितकारी।"
      },
      {
         "id":3,
         "type":"chaupai",
         "text":"सुन लीजै प्रभु अरज हमारी॥"
      },
      {
         "id":4,
         "type":"chaupai",
         "text":"जन के काज विलंब न कीजै।"
      },
      {
         "id":5,
         "type":"chaupai",
         "text":"आतुर दौड़ि महा सुख दीजै॥"
      },
      {
         "id":6,
         "type":"chaupai",
         "text":"जैसे कूदि सिंधु वहि पारा।"
      },
      {
         "id":7,
         "type":"chaupai",
         "text":"सुरसा बदन पैठि विस्तारा॥"
      },
      {
         "id":8,
         "type":"chaupai",
         "text":"आगे जाय लंकिनी रोका।"
      },
      {
         "id":9,
         "type":"chaupai",
         "text":"मारेहु लात गई सुरलोका॥"
      },
      {
         "id":10,
         "type":"chaupai",
         "text":"जाय विभीषण को सुख दीन्हा।"
      },
      {
         "id":11,
         "type":"chaupai",
         "text":"सीता निरखि परम पद लीन्हा॥"
      },
      {
         "id":12,
         "type":"chaupai",
         "text":"बाग उजारी सिंधु महँ बोरा।"
      },
      {
         "id":13,
         "type":"chaupai",
         "text":"अति आतुर जमकातर तोरा॥"
      },
      {
         "id":14,
         "type":"chaupai",
         "text":"अक्षय कुमार मारि संहारा।"
      },
      {
         "id":15,
         "type":"chaupai",
         "text":"लूम लपेटि लंक को जारा॥"
      },
      {
         "id":16,
         "type":"chaupai",
         "text":"लाह समान लंक जरि गई।"
      },
      {
         "id":17,
         "type":"chaupai",
         "text":"जय जय धुनि सुरपुर महँ भई॥"
      },
      {
         "id":18,
         "type":"chaupai",
         "text":"अब विलंब केहि कारण स्वामी।"
      },
      {
         "id":19,
         "type":"chaupai",
         "text":"कृपा करहु उर अंतरयामी॥"
      },
      {
         "id":20,
         "type":"chaupai",
         "text":"जय जय लक्ष्मण प्राण के दाता।"
      },
      {
         "id":21,
         "type":"chaupai",
         "text":"आतुर होइ दुख हरहु निपाता॥"
      },
      {
         "id":22,
         "type":"chaupai",
         "text":"जय गिरिधर जय जय सुखसागर।"
      },
      {
         "id":23,
         "type":"chaupai",
         "text":"सुरसमूह समरथ भटनागर॥"
      },
      {
         "id":24,
         "type":"chaupai",
         "text":"ॐ हनु हनु हनु हनुमंत हठीले।"
      },
      {
         "id":25,
         "type":"chaupai",
         "text":"बैरिहि मारु बज्र की कीले॥"
      },
      {
         "id":26,
         "type":"chaupai",
         "text":"गदा बज्र लै बैरिहिं मारो।"
      },
      {
         "id":27,
         "type":"chaupai",
         "text":"महाराज प्रभु दास उबारो॥"
      },
      {
         "id":28,
         "type":"chaupai",
         "text":"ॐकार हुंकार महाप्रभु धावो।"
      },
      {
         "id":29,
         "type":"chaupai",
         "text":"बज्र गदा हनु विलंब न लावो॥"
      },
      {
         "id":30,
         "type":"chaupai",
         "text":"ॐ ह्रीं ह्रीं ह्रीं हनुमंत कपीसा।"
      },
      {
         "id":31,
         "type":"chaupai",
         "text":"हुं हुं हुं हनु अरि उर शीसा॥"
      },
      {
         "id":32,
         "type":"chaupai",
         "text":"सत्य होहु हरि शपथ पाय कै।"
      },
      {
         "id":33,
         "type":"chaupai",
         "text":"रामदूत धरु मारु धाय कै॥"
      },
      {
         "id":34,
         "type":"chaupai",
         "text":"जय जय जय हनुमत अगाधा।"
      },
      {
         "id":35,
         "type":"chaupai",
         "text":"दुख पावत जन केहि अपराधा॥"
      },
      {
         "id":36,
         "type":"chaupai",
         "text":"पूजा जप तप नेम अचारा।"
      },
      {
         "id":37,
         "type":"chaupai",
         "text":"नहिं जानत कछु दास तुम्हारा॥"
      },
      {
         "id":38,
         "type":"chaupai",
         "text":"वन उपवन मग गिरि गृह माहीं।"
      },
      {
         "id":39,
         "type":"chaupai",
         "text":"तुम्हरे बल हम डरपत नाहीं॥"
      },
      {
         "id":40,
         "type":"chaupai",
         "text":"पाय परौं करि जोरि मनावौं।"
      },
      {
         "id":41,
         "type":"chaupai",
         "text":"यहि अवसर अब केहि गोहरावौं॥"
      },
      {
         "id":42,
         "type":"chaupai",
         "text":"जय अंजनि कुमार बलवंता।"
      },
      {
         "id":43,
         "type":"chaupai",
         "text":"शंकर सुवन वीर हनुमंता॥"
      },
      {
         "id":44,
         "type":"chaupai",
         "text":"बदन कराल काल कुल घालक।"
      },
      {
         "id":45,
         "type":"chaupai",
         "text":"राम सहाय सदा प्रतिपालक॥"
      },
      {
         "id":46,
         "type":"doha",
         "text":"॥ दोहा ॥\nप्रेम प्रतीति कपि भजै, सदा धरै उर ध्यान।\nतेहि के कारज सकल शुभ, सिद्ध करैं हनुमान॥"
      }
   ]
}